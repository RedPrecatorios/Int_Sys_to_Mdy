# Copie para .env na VM:  cp .env.example .env  &&  nano .env
#
# Monday.com (obrigatório para inserir itens)
MONDAY_API_TOKEN=
MONDAY_BOARD_ID=7345244366
MONDAY_API_URL=https://api.monday.com/v2

# E-mail de um utilizador Monday (coluna Permissão / people)
PERMISSAO=aline.chaves@redprecatorios.com.br

# Segurança (opcional): allowlist por IP para POST /incluir
# - Vazio = permite qualquer IP
# - Aceita IPs e CIDRs separados por vírgula (ex.: "1.2.3.4, 10.0.0.0/24")
ALLOWED_SOURCE_IPS=
#
# Se você estiver atrás de reverse proxy (Nginx/Traefik/Cloudflare) e quiser usar X-Forwarded-For:
# ATENÇÃO: só ative se você confia no proxy, senão qualquer cliente pode forjar o header.
TRUST_PROXY=false

# Template ligação → coluna Monday "RPV/PRC" (status): use um label que exista no board.
# Ex.: PRC-TJSP. Deixe vazio para não enviar essa coluna (user_tipo vai só em observações).
LIGACAO_MONDAY_RPV_PRC=

# Template ligação → coluna Monday "Comprador" (status): tem de ser um LABEL existente no board.
# user_nome (default) = nome do operador | user_agente = código (só se a Monday tiver labels iguais aos códigos).
LIGACAO_MONDAY_COMPRADOR_CAMPO=user_nome
# Opcional: mapear código → label, ex.: {"00805":"Jessica Silva","00788":"Karina Aparecida"}
#LIGACAO_MONDAY_COMPRADOR_MAP_JSON=

# Label único da coluna Monday "Status Compras" para todo item criado via API (template ligação).
#LIGACAO_MONDAY_STATUS_COMPRAS_LIGACAO=Inclusão - SysCALL

# Opcional — usados por scripts/run_server.sh
# HOST=0.0.0.0
# PORT=8000

# Auditoria de requisições (POST /incluir)
# - off  : desativa
# - file : grava em JSONL local
# - mysql: grava no MySQL
# - both : grava nos dois
AUDIT_MODE=file
AUDIT_LOG_PATH=logs/requisicoes_incluir.jsonl
#
# Se AUDIT_MODE incluir mysql:
# Use MYSQL_* OU (se vazio) EDA_MYSQL_* — mesma ordem de prioridade em cada campo.
MYSQL_HOST=
MYSQL_PORT=
MYSQL_DB=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_AUDIT_TABLE=request_audit
#
# request_audit: monday_resultado = ignorado | tentado_sucesso | tentado_erro | nao_tentado
#
EDA_MYSQL_HOST=127.0.0.1
EDA_MYSQL_PORT=3306
EDA_MYSQL_DATABASE=plataforma_central
EDA_MYSQL_USER=eda_app
EDA_MYSQL_PASSWORD=
#
# Fuso da sessão MySQL ao gravar primeira_requisicao_at / ultima_ligacao_at (NOW).
# Se o servidor MySQL está em UTC, sem isto os horários parecem ~3h à frente do Brasil.
# - Omitir a variável: usa -03:00 (horário de Brasília).
# - MYSQL_SESSION_TIME_ZONE=  (vazio): não altera a sessão (comportamento antigo).
# - Outros: +00:00 | America/Sao_Paulo (requer tabelas de time zone no MySQL)
MYSQL_SESSION_TIME_ZONE=-03:00
